// Hernandez Solutions | Lead Command Center
// Money is stored as Decimal(12,2). Estimated pipeline value is never counted as revenue;
// only Client records carry contracted revenue.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users, sessions and security
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  SALES
  VIEWER
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  role            Role      @default(SALES)
  active          Boolean   @default(true)
  // AES-256-GCM encrypted TOTP secret (see src/lib/crypto.ts). Never stored in plain text.
  mfaSecretEnc    String?
  mfaEnabled      Boolean   @default(false)
  dailyCallGoal   Int       @default(10)
  dashboardLayout Json?
  // Random token for the private calendar (.ics) feed; rotating it revokes old subscriptions.
  calendarToken   String?   @unique
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions        Session[]
  ownedCompanies  Company[]         @relation("CompanyOwner")
  activities      Activity[]
  tasks           Task[]            @relation("TaskAssignee")
  queueItems      CallQueueItem[]
  savedViews      SavedView[]
  emailsCreated   EmailMessage[]    @relation("EmailCreatedBy")
  emailsApproved  EmailMessage[]    @relation("EmailApprovedBy")
  auditLogs       AuditLog[]
  importBatches   ImportBatch[]
  clientsServiced Client[]          @relation("ClientTechnician")
}

model Session {
  // SHA-256 of the cookie token; the raw token only ever lives in the browser cookie.
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaVerified Boolean  @default(false)
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  expiresAt   DateTime

  @@index([userId])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model SavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // Same shape as the lead list's URL filters (see src/lib/leads/filters.ts).
  filters   Json
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

enum PipelineStage {
  NEW_LEAD
  RESEARCHING
  READY_TO_CONTACT
  ATTEMPTED_CONTACT
  CONTACTED
  FOLLOW_UP_REQUIRED
  INTERESTED
  DISCOVERY_SCHEDULED
  DISCOVERY_COMPLETED
  ASSESSMENT
  PROPOSAL_DRAFTING
  PROPOSAL_SENT
  NEGOTIATION
  CONTRACT_SENT
  CLOSED_WON
  CLOSED_LOST
  NOT_INTERESTED
  FUTURE_OPPORTUNITY
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum BusinessStage {
  STARTUP
  ESTABLISHED
  UNKNOWN
}

enum VerificationStatus {
  VERIFIED
  UNVERIFIED
  UNKNOWN
  INVALID
}

enum ContactMethod {
  EMAIL
  PHONE
  CONTACT_FORM
  LINKEDIN
  IN_PERSON
  UNKNOWN
}

model Company {
  id                     String             @id @default(cuid())
  // ID from the source list (for example "HS-001"), so re-importing the same file never duplicates.
  externalId             String?            @unique
  name                   String
  // Lower-cased, punctuation and legal suffixes removed; used for duplicate detection only.
  normalizedName         String
  industry               String             @default("other")
  subindustry            String?
  businessStage          BusinessStage      @default(UNKNOWN)
  website                String?
  domain                 String?
  streetAddress          String?
  city                   String?
  state                  String?
  zip                    String?
  region                 String?
  headquarters           String?
  additionalLocations    String[]           @default([])
  employeeCount          Int?
  employeeCountSource    String?
  description            String?
  ownershipType          String?
  fundingStage           String?
  growthIndicators       String?
  mainEmail              String?
  mainEmailStatus        VerificationStatus @default(UNKNOWN)
  mainPhone              String?
  normalizedPhone        String?
  mainPhoneStatus        VerificationStatus @default(UNKNOWN)
  contactFormUrl         String?
  preferredContactMethod ContactMethod      @default(UNKNOWN)
  source                 String?
  sourceUrl              String?
  lastVerifiedAt         DateTime?
  // A true, specific line about this prospect used to open emails and calls.
  personalNote           String?

  priority               Priority           @default(MEDIUM)
  score                  Int?
  scoreIsEstimate        Boolean            @default(true)
  // { factorKey: { points, evidence } } — see src/lib/scoring.ts
  scoreBreakdown         Json?
  stage                  PipelineStage      @default(NEW_LEAD)
  stageChangedAt         DateTime           @default(now())
  ownerId                String?
  owner                  User?              @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  discoveredAt           DateTime           @default(now())
  lastContactedAt        DateTime?
  nextFollowUpAt         DateTime?
  callCount              Int                @default(0)
  emailCount             Int                @default(0)
  notes                  String?
  tags                   String[]           @default([])
  doNotContact           Boolean            @default(false)

  managedUsers           Int?
  pricePerUser           Decimal?           @db.Decimal(12, 2)
  // When set, replaces managedUsers × pricePerUser as the monthly estimate.
  monthlyValueOverride   Decimal?           @db.Decimal(12, 2)
  implementationFee      Decimal?           @db.Decimal(12, 2)
  closeProbability       Int?
  expectedCloseDate      DateTime?

  archived               Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  contacts               Contact[]
  activities             Activity[]
  tasks                  Task[]
  attachments            Attachment[]
  queueItems             CallQueueItem[]
  emails                 EmailMessage[]
  enrollments            Enrollment[]
  research               ResearchFinding[]
  client                 Client?
  duplicateReviews       DuplicateReview[]

  @@index([normalizedName])
  @@index([domain])
  @@index([normalizedPhone])
  @@index([industry])
  @@index([region])
  @@index([stage])
  @@index([nextFollowUpAt])
}

model Contact {
  id                     String             @id @default(cuid())
  companyId              String
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                   String
  title                  String?
  email                  String?
  emailStatus            VerificationStatus @default(UNKNOWN)
  phone                  String?
  phoneStatus            VerificationStatus @default(UNKNOWN)
  linkedinUrl            String?
  preferredContactMethod ContactMethod      @default(UNKNOWN)
  source                 String?
  verifiedAt             DateTime?
  isPrimary              Boolean            @default(false)
  isDecisionMaker        Boolean            @default(false)
  doNotContact           Boolean            @default(false)
  notes                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  activities             Activity[]
  tasks                  Task[]
  emails                 EmailMessage[]
  enrollments            Enrollment[]
  queueItems             CallQueueItem[]

  @@index([companyId])
  @@index([email])
}

enum ActivityType {
  CALL
  EMAIL_SENT
  EMAIL_APPROVED
  NOTE
  STAGE_CHANGE
  MEETING
  FOLLOW_UP_CREATED
  FOLLOW_UP_DONE
  IMPORTED
  UPDATED
  CONVERTED
  RESEARCH
  REPLY_RECEIVED
  ATTACHMENT
}

enum CallOutcome {
  NO_ANSWER
  LEFT_VOICEMAIL
  RECEPTIONIST
  DECISION_MAKER_IDENTIFIED
  SPOKE_WITH_DECISION_MAKER
  REQUESTED_EMAIL
  INTERESTED
  MEETING_SCHEDULED
  NOT_INTERESTED
  WRONG_NUMBER
  CALL_BACK_LATER
}

model Activity {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  type        ActivityType
  callOutcome CallOutcome?
  durationSec Int?
  summary     String
  body        String?
  meta        Json?
  occurredAt  DateTime     @default(now())

  @@index([companyId, occurredAt])
  @@index([type, occurredAt])
  @@index([userId, occurredAt])
}

enum TaskType {
  CALLBACK
  EMAIL
  MEETING
  PROPOSAL
  CONTRACT
  REENGAGE
  OTHER
}

model Task {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  type        TaskType
  title       String
  notes       String?
  dueAt       DateTime
  durationMin Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([dueAt, completedAt])
  @@index([companyId])
}

model Attachment {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  size       Int
  data       Bytes
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Daily call center
// ---------------------------------------------------------------------------

enum QueueStatus {
  PENDING
  DONE
  SKIPPED
}

model CallQueueItem {
  id          String       @id @default(cuid())
  // Calendar day in the business time zone, "YYYY-MM-DD".
  day         String
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  position    Int
  reason      String?
  status      QueueStatus  @default(PENDING)
  outcome     CallOutcome?
  completedAt DateTime?

  @@unique([day, userId, companyId])
  @@index([userId, day])
}

// ---------------------------------------------------------------------------
// Email outreach
// ---------------------------------------------------------------------------

enum TemplateChannel {
  EMAIL
  CALL_SCRIPT
}

model Template {
  id        String          @id @default(cuid())
  channel   TemplateChannel @default(EMAIL)
  name       String
  // Industry keys this is the first-touch email for. Empty = follow-ups, scripts and general use.
  industries String[]        @default([])
  // Set on templates the app ships with, so re-seeding updates only those (and only if unedited).
  builtInKey String?         @unique
  edited     Boolean         @default(false)
  subject    String          @default("")
  body      String
  active    Boolean         @default(true)
  builtIn   Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  steps     SequenceStep[]
  emails    EmailMessage[]
}

model Sequence {
  id          String         @id @default(cuid())
  name        String
  description String?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  steps       SequenceStep[]
  enrollments Enrollment[]
}

model SequenceStep {
  id         String    @id @default(cuid())
  sequenceId String
  sequence   Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order      Int
  // Days after the previous email was SENT (step 1: days after enrollment, normally 0).
  delayDays  Int
  // null = use the lead's industry template for step 1, or the generic follow-up for this step.
  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // When true, the follow-up is a reply in the same thread ("Re: <previous subject>").
  sameThread Boolean   @default(true)

  @@unique([sequenceId, order])
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  REPLIED
  COMPLETED
  STOPPED
}

model Enrollment {
  id            String           @id @default(cuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  sequenceId    String
  sequence      Sequence         @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  toEmail       String
  status        EnrollmentStatus @default(ACTIVE)
  // Order of the last step that was drafted (0 = nothing drafted yet).
  currentStep   Int              @default(0)
  nextStepDueAt DateTime?
  stopReason    String?
  createdById   String?
  startedAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  emails        EmailMessage[]

  @@index([status, nextStepDueAt])
}

enum EmailStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENDING
  SENT
  FAILED
  CANCELLED
}

model EmailMessage {
  id                String       @id @default(cuid())
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId         String?
  contact           Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  enrollmentId      String?
  enrollment        Enrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  stepOrder         Int?
  templateId        String?
  template          Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  toEmail           String
  subject           String
  body              String
  status            EmailStatus  @default(DRAFT)
  createdById       String?
  createdBy         User?        @relation("EmailCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById      String?
  approvedBy        User?        @relation("EmailApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  sentAt            DateTime?
  // "gmail", "graph" or "manual" (sent from the user's own email app and marked sent).
  sentVia           String?
  providerMessageId String?
  inReplyTo         String?
  error             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Research, import and duplicates
// ---------------------------------------------------------------------------

enum FindingStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model ResearchFinding {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  field       String
  value       String
  sourceUrl   String
  sourceTitle String?
  quote       String?
  retrievedAt DateTime      @default(now())
  status      FindingStatus @default(PENDING)
  createdById String?
  decidedAt   DateTime?

  @@index([companyId, status])
}

model ImportBatch {
  id          String            @id @default(cuid())
  fileName    String
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  // Counts and lists described in src/lib/import/report.ts
  report      Json
  reviews     DuplicateReview[]
}

enum ReviewStatus {
  OPEN
  MERGED
  KEPT_SEPARATE
  DISCARDED
}

model DuplicateReview {
  id            String       @id @default(cuid())
  batchId       String?
  batch         ImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  // The existing record the incoming row may duplicate.
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // The incoming row, already normalized (see src/lib/import/types.ts).
  candidate     Json
  reasons       String[]
  status        ReviewStatus @default(OPEN)
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([status])
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

model Client {
  id                String    @id @default(cuid())
  companyId         String    @unique
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractStart     DateTime
  renewalDate       DateTime?
  managedUsers      Int
  monthlyValue      Decimal   @db.Decimal(12, 2)
  implementationFee Decimal?  @db.Decimal(12, 2)
  primaryContactId  String?
  // Tenant identifiers only. Passwords, secrets and privileged credentials never go in the CRM.
  tenantDomain      String?
  tenantId          String?
  serviceScope      String?
  technicianId      String?
  technician        User?     @relation("ClientTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  // [{ label, done, doneAt }]
  onboarding        Json
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
