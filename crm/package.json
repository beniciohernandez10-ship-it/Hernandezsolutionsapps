{
  "name": "hs-lead-command-center",
  "version": "0.1.0",
  "private": true,
  "description": "Hernandez Solutions | Lead Command Center: CRM, lead tracking and sales pipeline",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:vercel": "prisma generate && tsx scripts/deploy-migrate.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed.ts",
    "user:create": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/create-user.ts",
    "jobs:run": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/run-jobs.ts",
    "import:file": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-file.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "nodemailer": "^10.1.1",
    "otplib": "^12.0.1",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.8",
    "jszip": "^3.10.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
