# Copy to .env.local for local development. In production, set these in the Vercel
# project's Settings → Environment Variables. Never commit real values.

# PostgreSQL connection string (Neon in production).
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm_dev"

# 32 random bytes, base64. Encrypts two-step sign-in secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# One-time code for creating the first owner account at /setup (16+ characters).
SETUP_TOKEN=""

# Vercel sends this as a Bearer token to /api/cron/daily. Any long random string.
CRON_SECRET=""

# The address people use to open the app, and the host names it answers on.
APP_ORIGIN="http://localhost:3000"
ALLOWED_HOSTS="localhost"

# Time zone for "today", call goals and follow-up dates.
BUSINESS_TZ="America/Los_Angeles"

# Email sending through Gmail. Use an app password, not the account password.
# Leave both blank to use "open in my mail app" only.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Optional: send through Microsoft 365 instead (once a domain mailbox exists).
# When all four are set they take priority over Gmail.
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_SENDER=""

# Lets the website post its form submissions here (/api/inbound/website-lead). Any long random
# string. Set the same value as CRM_WEBHOOK_SECRET on the website.
WEBSITE_LEAD_SECRET=""

# Optional: enables the AI research assistant on prospect profiles.
ANTHROPIC_API_KEY=""
