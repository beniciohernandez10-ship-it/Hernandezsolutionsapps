          "redirect": null
        }
      },
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            {
              "op": "pre",
              "type": "path",
              "value": "/api/"
            }
          ]
        }
      ],
      "description": "Forms and newsletter endpoints: 20 requests per minute per IP, then 429. Protects inbox, leads and email quota.",
      "id": "rule_rate_limit_form_ap_is_m4lSvG",
      "name": "Rate limit form APIs",
      "valid": true,
      "validationErrors": null,
      "_status": "live"
    },
