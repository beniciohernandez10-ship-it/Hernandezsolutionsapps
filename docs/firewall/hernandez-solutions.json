        "mitigate": {
          "action": "deny",
          "actionDuration": null,
          "rateLimit": null,
          "redirect": null
        }
      },
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            {
              "op": "re",
              "type": "path",
              "value": "^/(wp-|wordpress|xmlrpc[.]php|phpmyadmin|cgi-bin|[.]env|[.]git|[.]aws|[.]ssh|.*[.]php$)"
