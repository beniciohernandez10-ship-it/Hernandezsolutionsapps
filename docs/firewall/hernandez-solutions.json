      "action": {
        "mitigate": {
          "action": "rate_limit",
          "actionDuration": null,
          "rateLimit": {
            "action": "rate_limit",
            "algo": "fixed_window",
            "keys": [
              "ip"
            ],
            "limit": 20,
            "window": 60
