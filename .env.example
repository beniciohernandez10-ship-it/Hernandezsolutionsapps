# Hernandez Solutions IT Center: environment variables.
# Copy to .env.local for local development. Never commit real values.
# In Vercel, set these under Project → Settings → Environment Variables,
# separately for Development, Preview and Production.

# Public origin of the portal (exact, no trailing slash). Used for redirects,
# the OAuth callback and the CSRF origin check.
APP_ORIGIN=http://localhost:3000
# Public website (return links).
WEBSITE_URL=https://thehernandezsolutions.com
# Comma-separated host names this deployment answers for (optional, recommended in production).
# ALLOWED_HOSTS=portal.thehernandezsolutions.com

# ---- Database ---------------------------------------------------------------
# Production/staging: hosted PostgreSQL 13+ (e.g. Neon, Azure Database for PostgreSQL).
# Leave empty locally to use the embedded PGlite database in PGLITE_DATA_DIR.
DATABASE_URL=
# DATABASE_SSL=true
# DB_POOL_MAX=5
PGLITE_DATA_DIR=./.data/pglite

# ---- Local demo -------------------------------------------------------------
# Enables fictional demo personas. Ignored in production and on non-localhost origins.
DEMO_MODE=true

# ---- Sessions ---------------------------------------------------------------
# SESSION_IDLE_MINUTES=120
# SESSION_ABSOLUTE_HOURS=12
# REAUTH_MINUTES=15
# Days after resolution before a ticket closes (customers can reopen until then).
# CLOSE_AFTER_DAYS=5

# ---- Microsoft Entra ID (user sign-in) -------------------------------------
# App registration: "Hernandez Solutions IT Center (sign-in)". See docs/microsoft-setup.md.
ENTRA_CLIENT_ID=
# Secret value: set in the Vercel/secret manager UI only.
ENTRA_CLIENT_SECRET=
# ENTRA_AUTHORITY_TENANT=organizations

# ---- Microsoft Graph (background Intune inventory) --------------------------
# Separate app registration with application permission DeviceManagementManagedDevices.Read.All.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ---- Atera ------------------------------------------------------------------
# One variable per Atera account; the atera_connections table stores only the variable NAME.
ATERA_API_KEY=

# ---- Jobs -------------------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/jobs.
CRON_SECRET=

# Email (docs/email-setup.md). Without these, notifications are in-app only.
RESEND_API_KEY=
EMAIL_FROM=
# Reply-by-email and intake. Both required to accept inbound email.
INBOUND_EMAIL_DOMAIN=
RESEND_WEBHOOK_SECRET=
# Off-site, append-only audit log (docs/audit-log.md). Set by npm run audit:setup; uses the audit_writer login, never the owner.
AUDIT_DATABASE_URL=
# AI assistant (docs/ai-assistant.md). Without a key the assistant is hidden; operators also turn it on per customer.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# Antivirus for attachments (docs/email-setup.md section 3). Without it, files pass the built-in checks only.
CLOUDMERSIVE_API_KEY=
# File attachments in production: connect a private Vercel Blob store (sets BLOB_STORE_ID).
# Locally, files are stored under .data/attachments.
